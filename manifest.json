{
  "manifest_version": 3,
  "name": "Pratique",
  "version": "1.0.0",
  "description": "Save and apply permission templates on Shopify Dev Dashboard collaborator access requests.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://dev.shopify.com/*"],
      "js": ["src/loader.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js"],
      "matches": ["https://dev.shopify.com/*"]
    }
  ]
}
